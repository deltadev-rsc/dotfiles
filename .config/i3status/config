general {
    interval = 6
    colors = true
    color_good = '#A9B665'
    color_bad = '#EA6962'
    color_degraded = '#D8A657'
}

order += "tztime yekaterinburg"
order += "volume master"
order += "disk /"
order += "wireless wlo1"
order += "battery all"
order += "cpu_usage"
order += "memory"

disk "/" {
    format = "|  : %free"
}

tztime yekaterinburg {
    format = "  %Y-%m-%d %H:%M:%S"
    timezone = "Asia/Yekaterinburg" 
}

wireless wlo1 {
    format_up = "|  : %quality"
    format_down = "|  : down"
}

memory {
    format = "|  : %used"
    threshold_degraded = "|  : 10%"
    format_degraded = "|  : %free"
}

battery all {
    format = "| %status"
    format_percentage = "%.02f%s"
    format_down = "No battery"
    status_chr = "󰂄: CHR"
    status_bat = "󱊣: BAT"
    status_unk = "󰂂: UNK"
    status_full = "󰁹: FULL"
}

cpu_usage {
    format = "|  : %usage"
}

volume master {
    format = "|  : %volume"
    format_muted = "|  : muted"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}
